# ---------- Core ----------
DATABASE_URL=postgres://gadget:CHANGE_ME@localhost:5432/gadget
# Public base URL (used for payment callbacks, sitemap, canonical URLs)
APP_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
NODE_ENV=development

# ---------- Payment gateways (leave empty => "Not configured / Demo") ----------
# bKash Tokenized Checkout
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# SSLCommerz (cards, Nagad, Rocket, internet banking)
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=true

# ---------- SMS (Bangladesh) ----------
# Generic HTTP SMS gateway (e.g. BulkSMSBD / SSL Wireless / Alpha SMS). Leave empty => Not configured.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ---------- Email (SMTP-over-HTTP providers or any SMTP relay with HTTP API) ----------
# Resend-compatible HTTP API. Leave empty => Not configured.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM="Gadget Store <no-reply@example.com>"

# ---------- Courier ----------
# Steadfast Courier API (optional). Leave empty => manual courier entry.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# ---------- Object storage (S3-compatible: AWS S3, Cloudflare R2, DigitalOcean Spaces) ----------
# Leave empty => images are stored under ./uploads (development only)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---------- Analytics (optional) ----------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=

# Protects /api/cron/daily (daily summary, low stock, supplier dues)
CRON_SECRET=CHANGE_ME
